# CoinCoach Signal Cloud v0.2.5 — official Binance web chart capture
APP_ENV=development
DATABASE_PATH=data/coincoach.db

ACCOUNT_ACTIVATION_MODE=key_present
PUBLISH_ENABLED=false
LIVE_PUBLISH_APPROVED=false

# Official Binance public web chart capture. No custom chart renderer.
WEB_CAPTURE_ENABLED=true
RENDERED_CHART_ENABLED=false
MOBILE_CAPTURE_ENABLED=false

# Use DRY_RUN_ONLY for previews. Add real Square Creator OpenAPI keys only
# as GitHub Actions Secrets, never inside the repository.
BINANCE_SQUARE_KEY_ACCOUNT_01=
BINANCE_SQUARE_KEY_ACCOUNT_02=
BINANCE_SQUARE_KEY_ACCOUNT_03=
BINANCE_SQUARE_KEY_ACCOUNT_04=
BINANCE_SQUARE_KEY_ACCOUNT_05=
BINANCE_SQUARE_KEY_ACCOUNT_06=

BINANCE_SQUARE_SKILL_DIR=
POSTS_PER_ACCOUNT_PER_RUN=1
SYMBOL_COOLDOWN_HOURS=1

# Render Cron direct scheduler safety gates.
RENDER_LIVE_ENABLED=false
RENDER_LIVE_APPROVED=false
RENDER_ACCOUNT_MODE=round_robin
RENDER_SLOT_JITTER_MAX_SECONDS=120
RENDER_SLOT_TIMEOUT_SECONDS=780
STATELESS_SLOT_ROTATION=true

# Optional per-account social fan-out.
# Square always publishes first. Social destinations are used only when the
# active account has the destination credentials below and SOCIAL_LIVE_APPROVED=true.
SOCIAL_SYNDICATION_ENABLED=false
SOCIAL_LIVE_APPROVED=false
SOCIAL_STATE_PATH=data/state/account_01/social_delivery_state.json
SOCIAL_PENDING_RETRY_LIMIT=1
SOCIAL_REQUEST_TIMEOUT_SECONDS=45

DISCORD_PUBLISH_ENABLED=true
FACEBOOK_PUBLISH_ENABLED=true
INSTAGRAM_PUBLISH_ENABLED=true
THREADS_PUBLISH_ENABLED=true

DISCORD_WEBHOOK_URL=
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=
THREADS_USER_ID=
THREADS_ACCESS_TOKEN=

# Public image bridge required by Facebook, Instagram and Threads URL publishing.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=coincoach-signals
META_GRAPH_API_VERSION=
THREADS_API_BASE_URL=https://graph.threads.net/v1.0
